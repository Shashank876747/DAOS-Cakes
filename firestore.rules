rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['daosflorida@gmail.com', 'shashank.dhak27@gmail.com', 'ojeswidhakshna@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (data.role == 'admin' || data.role == 'customer');
    }

    // Validation for OrderRequest
    function isValidOrderRequest(data) {
      return data.keys().hasAll(['id', 'fullName', 'email', 'eventDate', 'orderType']) &&
             data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.eventDate is string && data.eventDate.size() <= 50 &&
             data.orderType is string && data.orderType.size() <= 100;
    }

    // Validation for MenuItem
    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'startingPrice', 'description']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (data.category == 'signature' || data.category == 'treats') &&
             data.startingPrice is string && data.startingPrice.size() <= 50 &&
             data.description is string && data.description.size() <= 500;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUserProfile(incoming());
      allow delete: if isAdmin();
    }

    // Site Settings Collection
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu Items Catalog Collection
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMenuItem(incoming());
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrderRequest(incoming());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

  }
}
