{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "provider": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Dynamic site configuration and text content",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "googleFormUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["siteName", "tagline"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Cake or treat catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["signature", "treats"] },
        "startingPrice": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "popular": { "type": "boolean" },
        "image": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "category", "startingPrice", "description"]
    },
    "OrderRequest": {
      "title": "OrderRequest",
      "description": "Custom cake order request submitted by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "eventDate": { "type": "string", "maxLength": 50 },
        "orderType": { "type": "string", "maxLength": 100 },
        "flavor": { "type": "string", "maxLength": 100 },
        "cakeSize": { "type": "string", "maxLength": 100 },
        "designNotes": { "type": "string", "maxLength": 1000 },
        "contactMethod": { "type": "string", "enum": ["email", "text", "both"] },
        "status": { "type": "string", "enum": ["pending", "reviewed", "confirmed", "completed", "cancelled"] },
        "submittedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "fullName", "email", "eventDate", "orderType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection indexed by Auth UID"
    },
    "/site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Global site settings document"
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Custom bakery menu and treat items catalog"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRequest" },
      "description": "Customer order requests"
    }
  }
}
